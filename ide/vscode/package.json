{
  "name": "bettercoder-ide",
  "displayName": "BetterCoder",
  "description": "Links the editor to the BetterCoder coach: it sees where you are, labels where the next step goes with its official line from the docs, and runs your file with ▶ Run. It never writes into your files.",
  "version": "0.1.0",
  "publisher": "bettercoder",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bettercoder.reconnect",
        "title": "BetterCoder: Reconnect"
      },
      {
        "command": "bettercoder.goToStep",
        "title": "BetterCoder: Go to the current step"
      },
      {
        "command": "bettercoder.seeOfficial",
        "title": "BetterCoder: See the official line for this step"
      },
      {
        "command": "bettercoder.run",
        "title": "Run",
        "category": "BetterCoder",
        "icon": "$(play)"
      }
    ],
    "themes": [
      {
        "label": "BetterCoder Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/bettercoder-dark.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bettercoder.run",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(py|js|mjs|cjs|ts|mts|cts|cs|java|kt|swift|c|cc|cpp|cxx)$/i",
          "group": "navigation@-10"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bettercoder.run",
        "key": "cmd+enter",
        "win": "ctrl+enter",
        "linux": "ctrl+enter",
        "when": "editorTextFocus && !notebookEditorFocused && resourceExtname =~ /^\\.(py|js|mjs|cjs|ts|mts|cts|cs|java|kt|swift|c|cc|cpp|cxx)$/i"
      }
    ]
  }
}
