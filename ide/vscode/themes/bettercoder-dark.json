    "editorCursor.foreground": "#e6e4df",
    "editor.selectionBackground": "#8b1e2d66",
    "editor.lineHighlightBackground": "#161617",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#1e1e1f",
    "editorWhitespace.foreground": "#2a2a2a",
    "editorWidget.background": "#171718",
    "editorWidget.border": "#2a2a2a",
    "editorHoverWidget.background": "#171718",
    "editorHoverWidget.border": "#333334",
    "editorSuggestWidget.background": "#171718",
    "editorSuggestWidget.border": "#2a2a2a",
    "editorSuggestWidget.selectedBackground": "#24141a",
    "editorGroupHeader.tabsBackground": "#0f0f10",
    "editorGroupHeader.tabsBorder": "#262626",
    "editorGroup.border": "#262626",
    "tab.activeBackground": "#0f0f10",
    "tab.activeForeground": "#f4f2ed",
    "tab.activeBorderTop": "#c0394b",
    "tab.inactiveBackground": "#0f0f10",
    "tab.inactiveForeground": "#8f8f8a",
    "tab.border": "#262626",
    "activityBar.background": "#0f0f10",
    "activityBar.foreground": "#e6e4df",
    "activityBar.inactiveForeground": "#77777a",
    "activityBar.border": "#262626",
