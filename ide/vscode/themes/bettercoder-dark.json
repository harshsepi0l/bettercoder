    "panelTitle.inactiveForeground": "#8f8f8a",
    "terminal.background": "#0c0c0d",
    "terminal.foreground": "#d6d4cf",
    "terminalCursor.foreground": "#d6d4cf",
    "statusBar.background": "#0f0f10",
    "statusBar.foreground": "#8f8f8a",
    "statusBar.border": "#262626",
    "statusBar.noFolderBackground": "#0f0f10",
    "statusBar.debuggingBackground": "#8b1e2d",
    "statusBarItem.remoteBackground": "#0f0f10",
    "statusBarItem.remoteForeground": "#8f8f8a",
    "titleBar.activeBackground": "#0f0f10",
    "titleBar.inactiveBackground": "#0f0f10",
    "titleBar.border": "#262626",
    "button.background": "#8b1e2d",
    "button.foreground": "#f4f2ed",
    "button.hoverBackground": "#a1283a",
    "button.secondaryBackground": "#262626",
    "button.secondaryForeground": "#f4f2ed",
    "badge.background": "#8b1e2d",
    "badge.foreground": "#f4f2ed",
    "progressBar.background": "#c0394b",
    "input.background": "#1e1e1f",
    "input.border": "#333334",
    "inputOption.activeBorder": "#c0394b",
    "dropdown.background": "#1e1e1f",
    "dropdown.border": "#333334",
    "textLink.foreground": "#ec7480",
    "textLink.activeForeground": "#ec7480",
    "quickInput.background": "#171718",
    "quickInputList.focusBackground": "#24141a",
    "menu.background": "#171718",
    "menu.selectionBackground": "#24141a",
    "scrollbarSlider.background": "#f4f2ed1a",
    "scrollbarSlider.hoverBackground": "#f4f2ed2a",
    "editorError.foreground": "#fb7185",
    "editorWarning.foreground": "#fbbf24",
    "editorInfo.foreground": "#74c0fc",
    "notebook.cellBorderColor": "#262626",
    "notebook.focusedCellBorder": "#c0394b",
    "notebook.selectedCellBorder": "#2a2a2a",
    "notebook.cellEditorBackground": "#0f0f10",
    "notebook.outputContainerBackgroundColor": "#0f0f10"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6a9955"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#ce9178"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#b5cea8"
      }
    },
    {
      "scope": [
        "constant.language",
        "variable.language",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.other.using",
        "keyword.control.import",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#c586c0"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#dcdcaa"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#4ec9b0"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#9cdcfe"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#4fc1ff"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9cdcfe"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#f1a2ab",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#ce9178"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#fb7185"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#4ec9b0",
    "class": "#4ec9b0",
    "type": "#4ec9b0",
    "function": "#dcdcaa",
    "method": "#dcdcaa",
    "parameter": "#9cdcfe",
    "variable": "#9cdcfe",
    "property": "#9cdcfe",
    "variable.readonly": "#4fc1ff"
  }
}
