    "activityBarBadge.background": "#8b1e2d",
    "activityBarBadge.foreground": "#f4f2ed",
    "sideBar.background": "#0f0f10",
    "sideBar.foreground": "#c9c7c2",
    "sideBar.border": "#262626",
