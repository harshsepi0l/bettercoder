{
  "name": "BetterCoder Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#2a2a2d",
    "focusBorder": "#8b1e2d",
    "selection.background": "#8b1e2d80",
    "widget.border": "#d9d9d6",
    "icon.foreground": "#66666b",
    "editor.background": "#ffffff",
    "editor.foreground": "#2a2a2d",
    "editorLineNumber.foreground": "#8a8a8f",
    "editorLineNumber.activeForeground": "#2a2a2d",
    "editorCursor.foreground": "#1c1c1e",
    "editor.selectionBackground": "#8b1e2d66",
    "editor.lineHighlightBackground": "#f6f6f4",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#efefed",
    "editorWhitespace.foreground": "#d9d9d6",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#d9d9d6",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#c9c9c6",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#d9d9d6",
    "editorSuggestWidget.selectedBackground": "#fbf1f2",
    "editorGroupHeader.tabsBackground": "#fbfbfa",
    "editorGroupHeader.tabsBorder": "#e2e2e0",
    "editorGroup.border": "#e2e2e0",
    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#1c1c1e",
    "tab.activeBorderTop": "#8b1e2d",
    "tab.inactiveBackground": "#fbfbfa",
    "tab.inactiveForeground": "#66666b",
    "tab.border": "#e2e2e0",
    "activityBar.background": "#fbfbfa",
    "activityBar.foreground": "#1c1c1e",
    "activityBar.inactiveForeground": "#7a7a7f",
    "activityBar.border": "#e2e2e0",
    "activityBar.activeBorder": "#8b1e2d",
    "activityBarBadge.background": "#8b1e2d",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#fbfbfa",
    "sideBar.foreground": "#3a3a3d",
    "sideBar.border": "#e2e2e0",
    "sideBarTitle.foreground": "#66666b",
    "sideBarSectionHeader.background": "#fbfbfa",
    "sideBarSectionHeader.border": "#e2e2e0",
    "list.activeSelectionBackground": "#e2e2e0",
    "list.activeSelectionForeground": "#1c1c1e",
    "list.inactiveSelectionBackground": "#efefed",
    "list.hoverBackground": "#efefed",
    "list.focusOutline": "#8b1e2d",
    "list.highlightForeground": "#8b1e2d",
    "panel.background": "#fbfbfa",
    "panel.border": "#e2e2e0",
    "panelTitle.activeForeground": "#1c1c1e",
    "panelTitle.activeBorder": "#8b1e2d",
    "panelTitle.inactiveForeground": "#66666b",
    "terminal.background": "#f3f3f1",
    "terminal.foreground": "#2a2a2d",
    "terminalCursor.foreground": "#2a2a2d",
    "statusBar.background": "#fbfbfa",
    "statusBar.foreground": "#66666b",
    "statusBar.border": "#e2e2e0",
    "statusBar.noFolderBackground": "#fbfbfa",
    "statusBar.debuggingBackground": "#8b1e2d",
    "statusBarItem.remoteBackground": "#fbfbfa",
    "statusBarItem.remoteForeground": "#66666b",
    "titleBar.activeBackground": "#fbfbfa",
    "titleBar.inactiveBackground": "#fbfbfa",
    "titleBar.border": "#e2e2e0",
    "button.background": "#8b1e2d",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#a1283a",
    "button.secondaryBackground": "#e2e2e0",
    "button.secondaryForeground": "#1c1c1e",
    "badge.background": "#8b1e2d",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#8b1e2d",
    "input.background": "#efefed",
    "input.border": "#c9c9c6",
    "inputOption.activeBorder": "#8b1e2d",
    "dropdown.background": "#efefed",
    "dropdown.border": "#c9c9c6",
    "textLink.foreground": "#8b1e2d",
    "textLink.activeForeground": "#8b1e2d",
    "quickInput.background": "#ffffff",
    "quickInputList.focusBackground": "#fbf1f2",
    "menu.background": "#ffffff",
    "menu.selectionBackground": "#fbf1f2",
    "scrollbarSlider.background": "#1c1c1e1a",
    "scrollbarSlider.hoverBackground": "#1c1c1e2a",
    "editorError.foreground": "#c92a2a",
    "editorWarning.foreground": "#8a5a00",
    "editorInfo.foreground": "#1d5c8a",
    "notebook.cellBorderColor": "#e2e2e0",
    "notebook.focusedCellBorder": "#8b1e2d",
    "notebook.selectedCellBorder": "#d9d9d6",
    "notebook.cellEditorBackground": "#fbfbfa",
    "notebook.outputContainerBackgroundColor": "#ffffff"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5a7a48"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9a4a1c"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#8a6a1c"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#2f6f4f"
      }
    },
    {
      "scope": [
        "constant.language",
        "variable.language",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#1d5c8a"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.other.using",
        "keyword.control.import",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#7a3e9d"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#2a2a2d"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#1d5c8a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#6b5a00"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#1f7a6a"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#24507a"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#0f5f9a"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#1d5c8a"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#24507a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#8b1e2d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#9a4a1c"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#c92a2a"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#1f7a6a",
    "class": "#1f7a6a",
    "type": "#1f7a6a",
    "function": "#6b5a00",
    "method": "#6b5a00",
    "parameter": "#24507a",
    "variable": "#24507a",
    "property": "#24507a",
    "variable.readonly": "#0f5f9a"
  }
}
